{
  "info": {
    "name": "ms-productos - Tienda en Línea (FS3 Exp1 S2)",
    "description": "Pruebas de ms-productos (puerto 8082). Requiere ms-usuarios corriendo en el puerto 8081: la carpeta Preparación inicia sesión con ADMIN, VENDEDOR y CLIENTE y guarda sus IDs para el header X-Usuario-Id. Ejecutar en orden con Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preparación: login en ms-usuarios",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{urlUsuarios}}/auth/login",
              "host": [
                "{{urlUsuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"Admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Rol ADMIN\", () => pm.expect(j.usuario.rol).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminId\", j.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login VENDEDOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
