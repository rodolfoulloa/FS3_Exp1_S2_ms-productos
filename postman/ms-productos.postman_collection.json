              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"vendedor@tienda.cl\",\n  \"password\": \"Vende123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Rol VENDEDOR\", () => pm.expect(j.usuario.rol).to.eql(\"VENDEDOR\"));",
                  "pm.collectionVariables.set(\"vendedorId\", j.usuario.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{urlUsuarios}}/auth/login",
              "host": [
                "{{urlUsuarios}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"cperez\",\n  \"password\": \"Cliente123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Rol CLIENTE\", () => pm.expect(j.usuario.rol).to.eql(\"CLIENTE\"));",
                  "pm.collectionVariables.set(\"clienteId\", j.usuario.id);",
                  "pm.collectionVariables.set(\"rolClienteId\", j.usuario.rolId);"
                ]
              }
            }
          ]
        }
      ]
    },
